# App
DEBUG=false

# MongoDB
MONGO_URL=mongodb://admin:secret@localhost:27017
MONGO_DB=docmanager
MONGO_USER=admin
MONGO_PASSWORD=secret
MONGO_PORT=27017

# Solr
SOLR_URL=http://localhost:8983/solr/documents
SOLR_PORT=8983

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=schien/qwen3.5-lite:latest
OLLAMA_TIMEOUT=30

# File storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
